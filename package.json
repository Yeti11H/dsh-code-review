{
  "name": "@ooohyg/dsh-code-review",
  "version": "0.2.0",
  "bin": { "dsh-review": "scripts/ci-review.mjs" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "description": "Evidence-based code review and incremental rechecks for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Yeti11H/dsh-code-review.git" },
  "homepage": "https://github.com/Yeti11H/dsh-code-review#readme",
  "bugs": { "url": "https://github.com/Yeti11H/dsh-code-review/issues" },
  "engines": { "node": ">=24.9.0" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./core": { "types": "./dist/core.d.ts", "default": "./dist/core.js" },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["dist", "locale", "scripts/*.mjs", "examples", "docs", "README.md", "LICENSE", "PROMPT.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "overlay": "node scripts/load.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "code-review"]
}
